<resources>
    <style name="Theme.GeoQuiz" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pink_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/pink_background</item>
        <item name="android:navigationBarColor">@color/pink_background</item>
        <item name="android:windowBackground">@color/pink_background</item>
    </style>
    <style name="Widget.GeoQuiz.Button" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/button_tint</item>
        <item name="android:textColor">@color/button_text</item>
    </style>
</resources>
